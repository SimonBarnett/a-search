# a-search maintainer — MSSQL + schedule knobs (no provider feed secrets)
A_SEARCH_ENV=sandbox

# MSSQL (placeholders — fill from deploy secret store)
MSSQL_SERVER=localhost
MSSQL_DATABASE=a_search_sandbox
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated: MSSQL_TRUSTED_CONNECTION=true

# Rolling schedule
MAINTAINER_TOP=10
MAINTAINER_INTERVAL_MINUTES=15
MAINTAINER_UPSERT_BATCH=5000

# a-search maintainer -- MSSQL + schedule knobs (no provider feed secrets)
A_SEARCH_ENV=sandbox

# MSSQL (placeholders only - fill from deploy secret store; never commit credentials)
# Live: a_search on WIN-MPRE8VI4U6U (FR-251 / FR-119).
# Sandbox (FR-121 / FR-251): a_search_sandbox on the same instance (never madeiradb).
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=a_search
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated (on-box / domain): MSSQL_TRUSTED_CONNECTION=true
# MSSQL_DOMAIN=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Rolling schedule
MAINTAINER_TOP=10
MAINTAINER_INTERVAL_MINUTES=15
MAINTAINER_UPSERT_BATCH=5000

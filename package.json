{
  "name": "a-search",
  "version": "0.0.1",
  "private": true,
  "description": "JWT search entry: fan-out to per-provider SQS + MSSQL local parts maintainer",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "validate:vision": "node --test tests/fr055j-validate-vision-pack.test.js",
    "synth": "npm run stage-entry && npx --no-install cdk synth --app \"node cdk/bin/a-search.js\" --quiet",
    "stage-entry": "node scripts/stage-entry-lambda-asset.js",
    "stage-maintainer": "node scripts/stage-maintainer-lambda-asset.js"
  },
  "dependencies": {
    "@a-search/shared": "file:shared",
    "@aws-sdk/client-s3": "^3.1147.0",
    "@aws-sdk/client-sqs": "^3.758.0",
    "mssql": "^11.0.2"
  },
  "devDependencies": {
    "aws-cdk": "^2.1144.0",
    "aws-cdk-lib": "^2.272.0",
    "constructs": "^10.8.1"
  }
}

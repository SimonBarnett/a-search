# a-search ecwid (local) - never commit real secrets
A_SEARCH_ENV=sandbox
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=a_search_sandbox
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
SQS_ECWID_URL=
S3_RESULTS_BUCKET=
ECWID_CLIENT_ID=
ECWID_CLIENT_SECRET=
# Per-store secret Bearer token lives in the vault (never commit)

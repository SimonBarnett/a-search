# a-search partnerize (local) — never commit real secrets
A_SEARCH_ENV=sandbox
MSSQL_SERVER=localhost
MSSQL_DATABASE=a_search_sandbox
MSSQL_USER=
MSSQL_PASSWORD=
SQS_PARTNERIZE_URL=
S3_RESULTS_BUCKET=

# Partnerize API token (parser / maintainer / onboarding hooks — placeholder
# until account details exist). Selftest treats a non-empty token as feed-ready.
PARTNERIZE_API_TOKEN=

# a-search partnerize (local) — never commit real secrets
A_SEARCH_ENV=sandbox
MSSQL_SERVER=localhost
MSSQL_DATABASE=a_search_sandbox
MSSQL_USER=
MSSQL_PASSWORD=
SQS_PARTNERIZE_URL=
S3_RESULTS_BUCKET=

# Maintainer feed hooks (FR-085) — placeholders only
# PartFeedKeys.FeedUrl is the durable locator; these fill auth / optional default URL.
PARTNERIZE_FEED_URL=
PARTNERIZE_API_KEY=
PARTNERIZE_FEED_TOKEN=
PARTNERIZE_PUBLISHER_ID=

# Selftest / onboarding (FR-084) — non-empty PARTNERIZE_API_TOKEN counts as feed-ready
PARTNERIZE_API_TOKEN=

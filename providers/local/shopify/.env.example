# a-search shopify (local) - never commit real secrets
# Merchant store Admin API -> MSSQL Parts (Source=shopify). From Madeira/clubmadeira.io.
A_SEARCH_ENV=sandbox
MSSQL_SERVER=localhost
MSSQL_DATABASE=a_search_sandbox
MSSQL_USER=
MSSQL_PASSWORD=
SQS_SHOPIFY_URL=
S3_RESULTS_BUCKET=
# Admin REST catalogue (FR-101): store host + Admin API access token.
# Example store URL: https://your-shop.myshopify.com  (placeholders only — never commit secrets)
SHOPIFY_STORE_URL=
SHOPIFY_ACCESS_TOKEN=
# Optional Admin API version (default 2024-10)
SHOPIFY_API_VERSION=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET_KEY=

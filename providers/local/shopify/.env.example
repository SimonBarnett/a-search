# a-search shopify (local) - never commit real secrets
# Merchant store Admin API -> MSSQL Parts (Source=shopify). From Madeira/clubmadeira.io.
A_SEARCH_ENV=sandbox
# MSSQL (placeholders only - fill from deploy secret store; never commit credentials)
# Live target: madeiradb on WIN-MPRE8VI4U6U (docs/environments.md FR-119)
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=madeiradb
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated (on-box / domain): MSSQL_TRUSTED_CONNECTION=true
# MSSQL_DOMAIN=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
SQS_SHOPIFY_URL=
S3_RESULTS_BUCKET=
# Admin REST catalogue (FR-101): store host + Admin API access token.
# Also used by worker (FR-103) to resolve relative Parts Urls.
# Example store URL: https://your-shop.myshopify.com  (placeholders only - never commit secrets)
SHOPIFY_STORE_URL=
# Optional tracking stamp for buildTrackedUrl (query param sid) -- FR-103
SHOPIFY_AFFILIATE_ID=
SHOPIFY_ACCESS_TOKEN=
# Optional Admin API version (default 2024-10)
SHOPIFY_API_VERSION=
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET_KEY=

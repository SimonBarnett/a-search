# a-search tradedoubler (local) -- never commit real secrets
A_SEARCH_ENV=sandbox

# MSSQL (placeholders only - fill from deploy secret store; never commit credentials)
# Live target: madeiradb on WIN-MPRE8VI4U6U (docs/environments.md FR-119)
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=madeiradb
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated (on-box / domain): MSSQL_TRUSTED_CONNECTION=true
# MSSQL_DOMAIN=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Queue + results
SQS_TRADEDOUBLER_URL=
S3_RESULTS_BUCKET=

# Tracked / affiliate account -- required by buildTrackedUrl for product URLs
# (query param tduid). Never commit a real id.
TRADEDOUBLER_AFFILIATE_ID=

# Maintainer feed hooks (FR-091) -- placeholders only
# PartFeedKeys.FeedUrl is the durable locator; these fill auth / optional default URL.
TRADEDOUBLER_FEED_URL=
TRADEDOUBLER_API_KEY=
TRADEDOUBLER_FEED_TOKEN=
TRADEDOUBLER_PUBLISHER_ID=

# Selftest / onboarding (FR-090) -- non-empty TRADEDOUBLER_API_TOKEN counts as feed-ready
TRADEDOUBLER_API_TOKEN=

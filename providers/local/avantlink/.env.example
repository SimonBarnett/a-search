# a-search avantlink (local) -- never commit real secrets
A_SEARCH_ENV=sandbox

# MSSQL Parts (search read path -- FR-098)
MSSQL_SERVER=localhost
MSSQL_DATABASE=a_search_sandbox
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated auth: MSSQL_TRUSTED_CONNECTION=true

# Queue + results
SQS_AVANTLINK_URL=
S3_RESULTS_BUCKET=

# Tracked / affiliate account -- required by buildTrackedUrl for product URLs
# (query param avad). Never commit a real id.
AVANTLINK_AFFILIATE_ID=

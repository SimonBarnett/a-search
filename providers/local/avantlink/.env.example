# a-search avantlink (local) -- never commit real secrets
A_SEARCH_ENV=sandbox

# MSSQL (placeholders only - fill from deploy secret store; never commit credentials)
# Live target: madeiradb on WIN-MPRE8VI4U6U (docs/environments.md FR-119)
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=madeiradb
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated (on-box / domain): MSSQL_TRUSTED_CONNECTION=true
# MSSQL_DOMAIN=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Queue + results
SQS_AVANTLINK_URL=
S3_RESULTS_BUCKET=

# Selftest / onboarding (FR-099) -- non-empty AVANTLINK_API_TOKEN counts as feed-ready
AVANTLINK_API_TOKEN=

# Tracked / affiliate account (FR-098) -- required by buildTrackedUrl for product URLs
# (query param avad). Never commit a real id.
AVANTLINK_AFFILIATE_ID=

# Maintainer feed hooks (FR-100) -- placeholders only
# PartFeedKeys.FeedUrl is the durable locator; these fill auth / optional default URL.
AVANTLINK_FEED_URL=
AVANTLINK_API_KEY=
AVANTLINK_FEED_TOKEN=
AVANTLINK_PUBLISHER_ID=

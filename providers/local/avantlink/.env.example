# a-search avantlink (local) -- never commit real secrets
A_SEARCH_ENV=sandbox

# MSSQL Parts (search / selftest -- FR-098 / FR-099)
MSSQL_SERVER=localhost
MSSQL_DATABASE=a_search_sandbox
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated auth: MSSQL_TRUSTED_CONNECTION=true

# Queue + results
SQS_AVANTLINK_URL=
S3_RESULTS_BUCKET=

# Selftest / onboarding (FR-099) -- non-empty AVANTLINK_API_TOKEN counts as feed-ready
AVANTLINK_API_TOKEN=

# Tracked / affiliate account (FR-098) -- query param avad
AVANTLINK_AFFILIATE_ID=

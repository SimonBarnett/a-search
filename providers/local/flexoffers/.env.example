# a-search flexoffers (local) -- never commit real secrets
A_SEARCH_ENV=sandbox

# MSSQL (placeholders only - fill from deploy secret store; never commit credentials)
# Live target: madeiradb on WIN-MPRE8VI4U6U (docs/environments.md FR-119)
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=madeiradb
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated (on-box / domain): MSSQL_TRUSTED_CONNECTION=true
# MSSQL_DOMAIN=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Queue + results
SQS_FLEXOFFERS_URL=
S3_RESULTS_BUCKET=

# Selftest / onboarding (FR-096) -- non-empty FLEXOFFERS_API_TOKEN counts as feed-ready
FLEXOFFERS_API_TOKEN=

# Tracked / affiliate account (FR-095) -- query param foid
# Never commit a real id.
FLEXOFFERS_AFFILIATE_ID=

# Maintainer feed hooks (FR-097) -- placeholders only
# PartFeedKeys.FeedUrl is the durable locator; these fill auth / optional default URL.
FLEXOFFERS_FEED_URL=
FLEXOFFERS_API_KEY=
FLEXOFFERS_FEED_TOKEN=
FLEXOFFERS_PUBLISHER_ID=

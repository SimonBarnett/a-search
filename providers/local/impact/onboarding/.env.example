# Impact onboarding runner (providers/local/impact/onboarding) — placeholders only.
# Never commit real tokens.

A_SEARCH_ENV=sandbox

# MSSQL pending-onboard queue (FR-051a/b) — reuse parent impact .env when set
# MSSQL_SERVER=
# MSSQL_DATABASE=
# MSSQL_USER=
# MSSQL_PASSWORD=
# Or: MSSQL_TRUSTED_CONNECTION=true
# IMPACT_PENDING_ONBOARD_TABLE=dbo.ImpactPendingOnboard

# Optional: Impact API when LOCKED (unused while API UNKNOWN)
# IMPACT_ACCOUNT_SID=
# IMPACT_AUTH_TOKEN=

# Drain safety (shared/onboarding/drain.js)
# ONBOARDING_MAX_ITERATIONS=100

# a-search Impact local provider -- secrets stay here (never commit real values)
A_SEARCH_ENV=sandbox

# MSSQL (placeholders only - fill from deploy secret store; never commit credentials)
# Live target: madeiradb on WIN-MPRE8VI4U6U (docs/environments.md FR-119)
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=a_search
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated (on-box / domain): MSSQL_TRUSTED_CONNECTION=true
# MSSQL_DOMAIN=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Queue + results
SQS_IMPACT_URL=
S3_RESULTS_BUCKET=

# Tracked / affiliate account (FR-248): campaign + media partner belong in the
# Impact tracking path /c/{mpId}/{adId}/{campaignId}. Tenant is subId1.
# Never commit real values.
IMPACT_CAMPAIGN_ID=
IMPACT_MEDIA_PARTNER_ID=
IMPACT_AD_ID=
# Optional host when wrapping a plain product URL (default example.sjv.io)
IMPACT_TRACKING_HOST=

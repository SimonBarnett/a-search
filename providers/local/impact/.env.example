# a-search Impact local provider — secrets stay here (never commit real values)
A_SEARCH_ENV=sandbox

# MSSQL Parts (search read path)
MSSQL_SERVER=
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated auth: MSSQL_TRUSTED_CONNECTION=true

# Queue + results
SQS_IMPACT_URL=
S3_RESULTS_BUCKET=

# Tracked / affiliate account (FR-057) — required by buildTrackedUrl for Impact
# product URLs; query param defaults to `subId1`. Never commit a real campaign id.
IMPACT_CAMPAIGN_ID=

# a-search webgains (local) -- never commit real secrets
A_SEARCH_ENV=sandbox

# MSSQL (placeholders only - fill from deploy secret store; never commit credentials)
# Live target: a_search (docs/environments.md FR-119, FR-251)
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=a_search
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated (on-box / domain): MSSQL_TRUSTED_CONNECTION=true
# MSSQL_DOMAIN=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Queue + results
SQS_WEBGAINS_URL=
S3_RESULTS_BUCKET=

# Tracked / affiliate account -- required by buildTrackedUrl for product URLs
# (query param wgcampaignid). Never commit a real id.
WEBGAINS_CAMPAIGN_ID=

# Selftest / onboarding (FR-087) -- non-empty WEBGAINS_API_TOKEN counts as feed-ready
WEBGAINS_API_TOKEN=

# Maintainer feed hooks (FR-088) -- placeholders only
# PartFeedKeys.FeedUrl is the durable locator; these fill auth / optional default URL.
WEBGAINS_FEED_URL=
WEBGAINS_API_KEY=
WEBGAINS_FEED_TOKEN=
WEBGAINS_PUBLISHER_ID=

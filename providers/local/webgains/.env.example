# a-search webgains (local) -- never commit real secrets
A_SEARCH_ENV=sandbox

# MSSQL Parts (search read path -- FR-086)
MSSQL_SERVER=localhost
MSSQL_DATABASE=a_search_sandbox
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated auth: MSSQL_TRUSTED_CONNECTION=true

# Queue + results
SQS_WEBGAINS_URL=
S3_RESULTS_BUCKET=

# Tracked / affiliate account -- required by buildTrackedUrl for product URLs
# (query param wgcampaignid). Never commit a real id.
WEBGAINS_CAMPAIGN_ID=

# Selftest / onboarding (FR-087) -- non-empty WEBGAINS_API_TOKEN counts as feed-ready
WEBGAINS_API_TOKEN=

# Maintainer feed hooks (FR-088) -- placeholders only
# PartFeedKeys.FeedUrl is the durable locator; these fill auth / optional default URL.
WEBGAINS_FEED_URL=
WEBGAINS_API_KEY=
WEBGAINS_FEED_TOKEN=
WEBGAINS_PUBLISHER_ID=

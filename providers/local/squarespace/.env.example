# a-search squarespace (local) - never commit real secrets
A_SEARCH_ENV=sandbox
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=a_search_sandbox
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
SQS_SQUARESPACE_URL=
S3_RESULTS_BUCKET=
# OAuth app (Secrets Manager a-search/{env}/providers/squarespace/app in prod)
SQUARESPACE_CLIENT_ID=
SQUARESPACE_CLIENT_SECRET=
# Selftest / catalog overrides (placeholders)
SQUARESPACE_ACCESS_TOKEN=
SQUARESPACE_API_KEY=
SQUARESPACE_API_BASE=https://api.squarespace.com
# Temporary API-key connect until OAuth client approved (Simon): default true
SQUARESPACE_API_KEY_FALLBACK=true
SQUARESPACE_REFRESH_KEEPALIVE_DAYS=5

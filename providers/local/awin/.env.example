# a-search Awin local provider — secrets stay here (never commit real values)
A_SEARCH_ENV=sandbox

# MSSQL Parts (search read path)
MSSQL_SERVER=
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated auth: MSSQL_TRUSTED_CONNECTION=true

# Queue + results
SQS_AWIN_URL=
S3_RESULTS_BUCKET=

# Awin feed credentials (parser / maintainer hooks — not used by search stub)
AWIN_PUBLISHER_ID=
AWIN_API_TOKEN=

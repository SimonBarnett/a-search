# a-search Awin local provider — secrets stay here (never commit real values)
A_SEARCH_ENV=sandbox

# MSSQL (placeholders only - fill from deploy secret store; never commit credentials)
# Live target: madeiradb on WIN-MPRE8VI4U6U (docs/environments.md FR-119)
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=madeiradb
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated (on-box / domain): MSSQL_TRUSTED_CONNECTION=true
# MSSQL_DOMAIN=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Queue + results
SQS_AWIN_URL=
S3_RESULTS_BUCKET=

# Tracked / affiliate account (FR-057) — required by buildTrackedUrl for Awin
# product URLs; query param defaults to `awinaffid`. Never commit a real id.
AWIN_PUBLISHER_ID=

# Awin API token (parser / maintainer / onboarding hooks — not the link tenant)
AWIN_API_TOKEN=

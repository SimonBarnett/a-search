# a-search Awin local provider — secrets stay here (never commit real values)
A_SEARCH_ENV=sandbox

# MSSQL Parts (search read path)
MSSQL_SERVER=
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated auth: MSSQL_TRUSTED_CONNECTION=true

# Queue + results
SQS_AWIN_URL=
S3_RESULTS_BUCKET=

# Tracked / affiliate account (FR-057) — required by buildTrackedUrl for Awin
# product URLs; query param defaults to `awinaffid`. Never commit a real id.
AWIN_PUBLISHER_ID=

# Awin API token (parser / maintainer / onboarding hooks — not the link tenant)
AWIN_API_TOKEN=

# a-search woocommerce (local) - never commit real secrets
# WooCommerce REST API -> MSSQL Parts (Source=woocommerce). From Madeira/clubmadeira.io.
A_SEARCH_ENV=sandbox
# MSSQL (placeholders only - fill from deploy secret store; never commit credentials)
# Live target: madeiradb on WIN-MPRE8VI4U6U (docs/environments.md FR-119)
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=madeiradb
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated (on-box / domain): MSSQL_TRUSTED_CONNECTION=true
# MSSQL_DOMAIN=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
SQS_WOOCOMMERCE_URL=
S3_RESULTS_BUCKET=
# Catalogue REST (FR-109): store origin + consumer key/secret; never commit real values
WOOCOMMERCE_STORE_URL=
# Selftest feed-ready fallback (FR-112); leave empty in committed examples
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
# Optional override (default /wp-json/wc/v3)
WOOCOMMERCE_API_PREFIX=
# Optional tracking stamp on product Urls (FR-111)
WOOCOMMERCE_AFFILIATE_ID=

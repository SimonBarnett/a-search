# a-search magento (local) - never commit real secrets
A_SEARCH_ENV=sandbox
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=a_search_sandbox
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
SQS_MAGENTO_URL=
S3_RESULTS_BUCKET=
MAGENTO_STORE_BASE_URL=
# Vault holds consumer key/secret + access token/secret per shop (never commit)

# a-search bigcommerce (local) - never commit real secrets
A_SEARCH_ENV=sandbox
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=a_search
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
SQS_BIGCOMMERCE_URL=
S3_RESULTS_BUCKET=
BIGCOMMERCE_CLIENT_ID=
BIGCOMMERCE_CLIENT_SECRET=
# Per-store X-Auth-Token lives in the vault (never commit)

# a-search admitad (local) -- never commit real secrets
A_SEARCH_ENV=sandbox

# MSSQL (placeholders only - fill from deploy secret store; never commit credentials)
# Live target: madeiradb on WIN-MPRE8VI4U6U (docs/environments.md FR-119)
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=madeiradb
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated (on-box / domain): MSSQL_TRUSTED_CONNECTION=true
# MSSQL_DOMAIN=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Queue + results
SQS_ADMITAD_URL=
S3_RESULTS_BUCKET=

# Selftest / onboarding (FR-093) -- non-empty ADMITAD_API_TOKEN counts as feed-ready
ADMITAD_API_TOKEN=

# Tracked / affiliate account (FR-092) -- query param tag. Never commit a real id.
ADMITAD_WEBSITE_ID=

# Maintainer feed hooks (FR-094) -- placeholders only
# PartFeedKeys.FeedUrl is the durable locator; these fill auth / optional default URL.
ADMITAD_FEED_URL=
ADMITAD_API_KEY=
ADMITAD_FEED_TOKEN=
ADMITAD_PUBLISHER_ID=

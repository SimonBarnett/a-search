# a-search admitad (local) -- never commit real secrets
A_SEARCH_ENV=sandbox

# MSSQL Parts (search read path -- FR-092)
MSSQL_SERVER=localhost
MSSQL_DATABASE=a_search_sandbox
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated auth: MSSQL_TRUSTED_CONNECTION=true

# Queue + results
SQS_ADMITAD_URL=
S3_RESULTS_BUCKET=

# Tracked / affiliate account -- required by buildTrackedUrl for product URLs
# (query param tag). Never commit a real id.
ADMITAD_WEBSITE_ID=

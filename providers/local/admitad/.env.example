# a-search admitad (local) -- never commit real secrets
A_SEARCH_ENV=sandbox

# MSSQL Parts (search / selftest -- FR-092 / FR-093)
MSSQL_SERVER=localhost
MSSQL_DATABASE=a_search_sandbox
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated auth: MSSQL_TRUSTED_CONNECTION=true

# Queue + results
SQS_ADMITAD_URL=
S3_RESULTS_BUCKET=

# Selftest / onboarding (FR-093) -- non-empty ADMITAD_API_TOKEN counts as feed-ready
ADMITAD_API_TOKEN=

# Tracked / affiliate account (FR-092) -- query param tag. Never commit a real id.
ADMITAD_WEBSITE_ID=

# a-search wix (local) - never commit real secrets
# Wix Stores API -> MSSQL Parts (Source=wix). From Madeira/clubmadeira.io.
A_SEARCH_ENV=sandbox
MSSQL_SERVER=localhost
MSSQL_DATABASE=a_search_sandbox
MSSQL_USER=
MSSQL_PASSWORD=
SQS_WIX_URL=
S3_RESULTS_BUCKET=
# Stores catalogue (FR-105): site id + API key (Authorization header). Placeholders only.
WIX_SITE_ID=
WIX_API_TOKEN=
# Optional override of https://www.wixapis.com
WIX_API_BASE=
WIX_CLIENT_ID=

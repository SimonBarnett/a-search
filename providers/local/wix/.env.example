# a-search wix (local) - never commit real secrets
# Wix Stores API -> MSSQL Parts (Source=wix). From Madeira/clubmadeira.io.
A_SEARCH_ENV=sandbox
# MSSQL (placeholders only - fill from deploy secret store; never commit credentials)
# Live target: madeiradb on WIN-MPRE8VI4U6U (docs/environments.md FR-119)
MSSQL_SERVER=<ionos-sql-host>
MSSQL_DATABASE=madeiradb
MSSQL_USER=
MSSQL_PASSWORD=
# Or integrated (on-box / domain): MSSQL_TRUSTED_CONNECTION=true
# MSSQL_DOMAIN=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true
SQS_WIX_URL=
S3_RESULTS_BUCKET=
# Stores catalogue (FR-105): site id + API key (Authorization header). Placeholders only.
WIX_SITE_ID=
# Selftest feed-ready fallback (FR-108); leave empty in committed examples
WIX_API_TOKEN=
# Optional override of https://www.wixapis.com
WIX_API_BASE=
WIX_CLIENT_ID=
# Worker (FR-107): store base resolves relative Parts Urls; optional tracking stamp (query param sid)
WIX_STORE_URL=
WIX_AFFILIATE_ID=

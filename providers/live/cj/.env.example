# a-search CJ live provider — secrets stay here (never commit real values)
A_SEARCH_ENV=sandbox

# CJ GraphQL (ads.api.cj.com) — never commit real tokens
CJ_API_TOKEN=
CJ_GRAPHQL_URL=https://ads.api.cj.com/query
# Optional company id for products(companyId: ...)
CJ_COMPANY_ID=

# Tracked / affiliate account (FR-057) — required by buildTrackedUrl for CJ
# product URLs; query param defaults to `sid`. Never commit a real website id.
CJ_WEBSITE_ID=

# Queue + results
SQS_CJ_URL=
S3_RESULTS_BUCKET=

# a-search Amazon live provider - secrets stay here (never commit real values)
A_SEARCH_ENV=sandbox

# Amazon Product Advertising API (placeholders)
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_HOST=webservices.amazon.co.uk
AMAZON_REGION=eu-west-1

# Tracked / affiliate account (FR-057) - required by buildTrackedUrl for Amazon
# links; query param name defaults to `tag`. Never commit a real partner tag.
AMAZON_PARTNER_TAG=

# Queue + results (FR-033: writeResults uses S3_RESULTS_BUCKET + default AWS
# credential chain when putObject is not injected)
SQS_AMAZON_URL=
S3_RESULTS_BUCKET=

# Amazon Creators API (FR-182 / FR #4584).
# Deploy fill-madeira reads optional SSM /madeira/amazon/creators-credential
# into AMAZON_CREATORS_CREDENTIAL (never commit a real value).
# Set AMAZON_SEARCH_API=creators for Creators Browse (FR #4562 default on workers).
AMAZON_SEARCH_API=paapi
AMAZON_CREATORS_ENABLED=false
AMAZON_CREATORS_CREDENTIAL=
AMAZON_CREATORS_ENDPOINT=https://api.amazon.com/creators/v1/search

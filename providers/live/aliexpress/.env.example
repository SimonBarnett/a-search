# a-search aliexpress (live) -- never commit real secrets
A_SEARCH_ENV=sandbox
# Affiliate / Open Platform app key. Stay-dark until account exists.
ALIEXPRESS_API_KEY=
# Optional alias accepted by search.js
# ALIEXPRESS_APP_KEY=
# Tracking id for affiliate product.query + buildTrackedUrl (FR-071/FR-072; default a-search)
ALIEXPRESS_TRACKING_ID=a-search
# Optional override (default https://api-sg.aliexpress.com/sync)
# ALIEXPRESS_API_BASE=
SQS_ALIEXPRESS_URL=
S3_RESULTS_BUCKET=

# a-search etsy (live) -- never commit real secrets
A_SEARCH_ENV=sandbox
# Open API v3 keystring. Secrets Manager JSON key ETSY_API_KEY; FR-170 / FR-244.
ETSY_API_KEY=
# Shared secret for x-api-key: keystring:shared_secret (required since 2026-02-09).
ETSY_SHARED_SECRET=
# Optional alias accepted by search.js
# ETSY_KEYSTRING=
# Optional override (default https://openapi.etsy.com/v3)
# ETSY_API_BASE=
# Affiliate network: rakuten (default, Simon) | awin (legacy fallback)
ETSY_AFFILIATE_NETWORK=rakuten
# Rakuten Advertising deep-link mid for Etsy + publisher id (reuse RAKUTEN_SITE_ID ok)
ETSY_RAKUTEN_MID=
RAKUTEN_PUBLISHER_ID=
# Legacy Awin mode only when ETSY_AFFILIATE_NETWORK=awin
# ETSY_AWIN_MID=
# AWIN_PUBLISHER_ID=
SQS_ETSY_URL=
S3_RESULTS_BUCKET=

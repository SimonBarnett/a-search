# a-search eBay live provider — secrets stay here (never commit real values)
A_SEARCH_ENV=sandbox

# eBay Browse API / OAuth (placeholders — never commit real values)
# Client credentials required; refresh token optional (uses client_credentials grant when empty)
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_REFRESH_TOKEN=
EBAY_MARKETPLACE_ID=EBAY_GB
# sandbox → api.sandbox.ebay.com ; production|live → api.ebay.com
EBAY_ENV=sandbox

# Queue + results
SQS_EBAY_URL=
S3_RESULTS_BUCKET=

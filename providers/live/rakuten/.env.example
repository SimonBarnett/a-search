# a-search Rakuten live provider — secrets stay here (never commit real values)
A_SEARCH_ENV=sandbox

# Rakuten Product Search (placeholders — never commit real values)
# APPLICATION_KEY required; AFFILIATE_ID optional; honour rate limits / Retry-After
RAKUTEN_APPLICATION_KEY=
RAKUTEN_AFFILIATE_ID=
RAKUTEN_ENDPOINT=https://api.rakuten.com/

# Tracked / affiliate account (FR-057) — required by buildTrackedUrl for Rakuten
# product URLs; query param defaults to `mid`. Never commit a real site id.
RAKUTEN_SITE_ID=

# Queue + results
SQS_RAKUTEN_URL=
S3_RESULTS_BUCKET=

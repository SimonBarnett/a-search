# a-search Rakuten live provider - secrets stay here (never commit real values)
A_SEARCH_ENV=sandbox

# Rakuten Advertising Product Search (placeholders only; never commit values)
# Token: POST api.linksynergy.com/token with Bearer base64(client_id:client_secret)
# and form scope=SID. Search uses the access token. Do not log the token.
RAKUTEN_CLIENT_ID=
RAKUTEN_CLIENT_SECRET=
RAKUTEN_SID=
RAKUTEN_TOKEN_URL=https://api.linksynergy.com/token
RAKUTEN_ENDPOINT=https://api.linksynergy.com/productsearch/1.0

# Tracked / affiliate account (FR-057) - required by buildTrackedUrl for Rakuten
# product URLs; query param defaults to `mid`. Never commit a real site id.
RAKUTEN_SITE_ID=

# Queue + results
SQS_RAKUTEN_URL=
S3_RESULTS_BUCKET=

# a-search Rakuten live provider - secrets stay here (never commit real values)
A_SEARCH_ENV=sandbox

# Rakuten Advertising Product Search (placeholders - never commit real values)
# Bearer token from the Developer Portal. Honour 100 calls/min.
RAKUTEN_PRODUCT_SEARCH_TOKEN=
RAKUTEN_ENDPOINT=https://api.linksynergy.com/productsearch/1.0

# Tracked link (FR-248): id = publisher, mid = advertiser, u1 = tenantId.
# RAKUTEN_SITE_ID is the publisher id. Never commit a real id.
RAKUTEN_SITE_ID=

# Queue + results
SQS_RAKUTEN_URL=
S3_RESULTS_BUCKET=

# a-search bol (live) -- never commit real secrets
A_SEARCH_ENV=sandbox
# Catalog / Partner API key (X-API-KEY). Secrets Manager JSON key BOL_API_KEY; FR-171.
BOL_API_KEY=
# Optional alias accepted by search.js (client id as keystand-in)
# BOL_CLIENT_ID=
# Optional override (default https://api.bol.com)
# BOL_API_BASE=
# Tracking / affiliate id for buildTrackedUrl (FR-080; default a-search)
BOL_TRACKING_ID=a-search
SQS_BOL_URL=
S3_RESULTS_BUCKET=

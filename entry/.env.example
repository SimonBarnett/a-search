# a-search entry — JWT + env only (no provider secrets)
# Copy to entry/.env and fill from the deploy secret store.

# live | sandbox — must match queues / SQL / result prefix for this process
A_SEARCH_ENV=sandbox

# Login JWT verification (issuer values UNKNOWN until deploy)
JWT_ISSUER=https://login.example.invalid/
JWT_AUDIENCE=a-search
JWT_JWKS_URL=https://login.example.invalid/.well-known/jwks.json
# HS256 shared secret (fixtures / when JWKS is not used). Alias: JWT_HS256_SECRET.
JWT_SECRET=
# JWT_HS256_SECRET=

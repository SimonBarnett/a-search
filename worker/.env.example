# Shared worker runtime (results writer FR-033)
# AWS credentials: default chain (env / instance role / shared config)
# S3_RESULTS_BUCKET is required for writeResults when putObject is not injected.

A_SEARCH_ENV=sandbox
S3_RESULTS_BUCKET=

